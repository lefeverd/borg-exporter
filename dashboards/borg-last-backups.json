{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 48,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "title": "Summary",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "RAW_SIZE",
          "expr": "borg_total_size_bytes",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "ACTUAL_SIZE",
          "expr": "borg_deduplicated_compressed_size_bytes",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "LAST_BACKUP_TS",
          "expr": "borg_last_backup_timestamp * 1000",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "LAST_BACKUP_RAW_SIZE",
          "expr": "borg_last_backup_original_size_bytes",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "LAST_BACKUP_ACTUAL_SIZE",
          "expr": "borg_last_backup_compressed_size_bytes",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "LAST_BACKUP_DEDUPLICATED_SIZE",
          "expr": "borg_last_backup_deduplicated_size_bytes",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "FILES",
          "expr": "borg_last_backup_files",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "DURATION",
          "expr": "borg_last_backup_duration_seconds",
          "format": "table",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "refId": "SINCE_LAST_BACKUP",
          "expr": "(time() * 1000) - (borg_last_backup_timestamp * 1000)",
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "config": {
                  "id": "isNotNull",
                  "options": {}
                },
                "fieldName": "repository"
              }
            ],
            "match": "any",
            "type": "include"
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "repository": { "aggregations": [], "operation": "groupby" },
              "Value #RAW_SIZE": { "aggregations": ["lastNotNull"], "operation": "aggregate" },
              "Value #ACTUAL_SIZE": { "aggregations": ["lastNotNull"], "operation": "aggregate" },
              "Value #LAST_BACKUP_TS": { "aggregations": ["max"], "operation": "aggregate" },
              "Value #LAST_BACKUP_RAW_SIZE": { "aggregations": ["lastNotNull"], "operation": "aggregate" },
              "Value #LAST_BACKUP_ACTUAL_SIZE": { "aggregations": ["lastNotNull"], "operation": "aggregate" },
              "Value #LAST_BACKUP_DEDUPLICATED_SIZE": { "aggregations": ["lastNotNull"], "operation": "aggregate" },
              "Value #FILES": { "aggregations": ["lastNotNull"], "operation": "aggregate" },
              "Value #DURATION": { "aggregations": ["lastNotNull"], "operation": "aggregate" },
              "Value #SINCE_LAST_BACKUP": { "aggregations": ["lastNotNull"], "operation": "aggregate" }
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "Value #NOW",
              "operator": "-",
              "right": "Value #LAST_BACKUP_TS (max)"
            },
            "alias": "Since Last Backup",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Value #NOW": true },
            "indexByName": {
              "repository": 0,
              "Value #RAW_SIZE (lastNotNull)": 1,
              "Value #ACTUAL_SIZE (lastNotNull)": 2,
              "Value #FILES (lastNotNull)": 3,
              "Value #LAST_BACKUP_RAW_SIZE (lastNotNull)": 4,
              "Value #LAST_BACKUP_ACTUAL_SIZE (lastNotNull)": 5,
              "Value #LAST_BACKUP_DEDUPLICATED_SIZE (lastNotNull)": 6,
              "Value #DURATION (lastNotNull)": 7,
              "Value #LAST_BACKUP_TS (max)": 8,
              "Value #SINCE_LAST_BACKUP (lastNotNull)": 9
            },
            "renameByName": {
              "repository": "Repository",
              "Value #RAW_SIZE (lastNotNull)": "Raw Size",
              "Value #ACTUAL_SIZE (lastNotNull)": "Actual Size",
              "Value #FILES (lastNotNull)": "Files",
              "Value #LAST_BACKUP_RAW_SIZE (lastNotNull)": "Last Original Size",
              "Value #LAST_BACKUP_ACTUAL_SIZE (lastNotNull)": "Last Compressed Size",
              "Value #LAST_BACKUP_DEDUPLICATED_SIZE (lastNotNull)": "Last Unique Data Added",
              "Value #DURATION (lastNotNull)": "Duration",
              "Value #LAST_BACKUP_TS (max)": "Last Backup Timestamp",
              "Value #SINCE_LAST_BACKUP (lastNotNull)": "Since Last Backup"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Raw Size" },
            "properties": [{ "id": "unit", "value": "decbytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Actual Size" },
            "properties": [{ "id": "unit", "value": "decbytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Files" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Last Original Size" },
            "properties": [{ "id": "unit", "value": "decbytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Last Compressed Size" },
            "properties": [{ "id": "unit", "value": "decbytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Last Unique Data Added" },
            "properties": [
              { "id": "unit", "value": "decbytes" },
              { "id": "custom.width", "value": 120 },
              { "id": "description", "value": "New data this backup added to the repository, relative to what else is currently in the repository (not the same as the backup's own size). An archive with content identical to another already in the repository can show 0 here even if it is a large, valid backup." }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [{ "id": "unit", "value": "dtdurations" }, { "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "Last Backup Timestamp" },
            "properties": [{ "id": "unit", "value": "dateTimeAsSystem" }]
          },
          {
            "matcher": { "id": "byName", "options": "Since Last Backup" },
            "properties": [
              { "id": "unit", "value": "dtdurationms" },
              { "id": "decimals", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "dark-green", "value": null },
                    { "color": "dark-orange", "value": 432000000 },
                    { "color": "dark-red", "value": 864000000 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      }
    },
